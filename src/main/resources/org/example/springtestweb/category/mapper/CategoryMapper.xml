<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.springtestweb.category.mapper.CategoryMapper">
    <select id="findByParentId" resultType="CategoryVo">
        SELECT *
        FROM goods_category
        WHERE parent_id = #{parentId}
    </select>
</mapper>
